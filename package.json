{
  "name": "nihao-landing",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev": "next dev",
    "build": "pnpm prisma:generate && next build --webpack",
    "start": "next start",
    "monitor:whatsapp": "node --import tsx scripts/run-whatsapp-operational-monitor.mts",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test --test-concurrency=1 tests/bot/*.test.mts",
    "test:e2e": "playwright test",
    "eval:business-cards": "node --import tsx --env-file-if-exists=.env.local scripts/run-evals.mts --suite business-cards",
    "eval:text": "node --import tsx --env-file-if-exists=.env.local scripts/run-evals.mts --suite text",
    "eval:audio": "node --import tsx --env-file-if-exists=.env.local scripts/run-evals.mts --suite transcript",
    "eval:real-audio": "node --import tsx --env-file-if-exists=.env.local scripts/run-evals.mts --suite audio",
    "eval:merge": "node --import tsx --env-file-if-exists=.env.local scripts/run-evals.mts --suite merge",
    "eval:channel": "node --import tsx --env-file-if-exists=.env.local scripts/run-evals.mts --suite channel",
    "eval:whatsapp-batches": "node --import tsx --env-file-if-exists=.env.local scripts/run-evals.mts --suite whatsapp-batches",
    "whatsapp:worker": "node --import tsx scripts/run-whatsapp-batches.mts",
    "eval:all": "node --import tsx --env-file-if-exists=.env.local scripts/run-evals.mts --suite all",
    "eval:compare": "node --import tsx scripts/run-evals.mts compare",
    "smoke:production": "node --experimental-transform-types --env-file-if-exists=.env.local scripts/smoke-production.mts",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:migrate:status": "prisma migrate status",
    "eval:whatsapp-products": "node --import tsx --env-file-if-exists=.env.local scripts/run-evals.mts --suite whatsapp-products",
    "eval:whatsapp-agent": "node --import tsx --env-file-if-exists=.env.local scripts/run-evals.mts --suite whatsapp-agent",
    "replay": "node --import tsx scripts/replay-whatsapp.mts",
    "monitor:watchdog": "node --import tsx scripts/run-whatsapp-monitor-watchdog.mts",
    "history:staging": "node --import tsx scripts/historical-corrections.mts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1132.0",
    "@aws-sdk/s3-request-presigner": "3.1132.0",
    "@better-auth/prisma-adapter": "1.7.5",
    "@fontpkg/droid-sans-fallback": "1.0.0",
    "@fontsource-variable/dm-sans": "5.3.0",
    "@fontsource-variable/manrope": "5.3.0",
    "@pdf-lib/fontkit": "1.1.1",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-slot": "^1.2.4",
    "better-auth": "1.7.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dejavu-fonts-ttf": "2.37.3",
    "exceljs": "^4.4.0",
    "lucide-react": "^1.17.0",
    "motion": "^12.40.0",
    "next": "16.3.8",
    "next-intl": "^4.13.2",
    "pdf-lib": "^1.17.1",
    "pg": "8.23.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "resend": "^6.28.1",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "8.15.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "16.6.1",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "playwright": "^1.60.0",
    "prisma": "7.10.0",
    "tailwindcss": "^4",
    "tsx": "4.23.15",
    "typescript": "^5"
  },
  "pnpm": {
    "overrides": {
      "brace-expansion@1": "1.1.21",
      "browserslist": "4.29.0",
      "fast-uri": "3.1.8",
      "js-yaml": "4.3.2",
      "mysql2": "3.24.4",
      "nanoid@3": "3.3.20",
      "postcss": "8.5.23",
      "sharp": "0.35.5",
      "source-map-js": "1.2.2",
      "deepmerge-ts": "8.0.0",
      "uuid@8": "11.1.1"
    }
  }
}
