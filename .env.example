# PostgreSQL estándar (Railway en producción). No incluir valores reales en Git.
DATABASE_URL=

# Better Auth. Generar un secreto aleatorio de al menos 32 caracteres.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3000
BETTER_AUTH_COOKIE_DOMAIN=

# Frontend-to-backend origin. Leave empty for the same-origin local setup.
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_AUTH_URL=
CORS_ALLOWED_ORIGINS=http://localhost:3000

# URL pública del frontend, usada exclusivamente para enlaces de invitación.
PUBLIC_APP_URL=http://localhost:3000

# Email transaccional de invitaciones (server-side solamente).
RESEND_API_KEY=
INVITATION_EMAIL_FROM=

# Cloudflare R2 S3-compatible. El endpoint es HTTPS y no incluye secretos.
# Ejemplo: https://<account-id>.r2.cloudflarestorage.com
R2_ENDPOINT=
R2_BUCKET=nihao-bot-assets
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Iteración 5B: provider de extracción Mistral, sólo server-side.
MISTRAL_API_KEY=

# Evolution API / WhatsApp. Sólo server-side; no usar prefijo NEXT_PUBLIC_.
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=
