# PostgreSQL estándar (Railway en producción). No incluir valores reales en Git.
DATABASE_URL=

# Better Auth. Generar un secreto aleatorio de al menos 32 caracteres.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3000
BETTER_AUTH_COOKIE_DOMAIN=

# Frontend-to-backend origin. Leave empty for the same-origin local setup.
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_AUTH_URL=
CORS_ALLOWED_ORIGINS=http://localhost:3000

# URL pública del frontend, usada exclusivamente para enlaces de invitación.
PUBLIC_APP_URL=http://localhost:3000

# Email transaccional de invitaciones (server-side solamente).
RESEND_API_KEY=
INVITATION_EMAIL_FROM=

# Cloudflare R2 S3-compatible. El endpoint es HTTPS y no incluye secretos.
# Ejemplo: https://<account-id>.r2.cloudflarestorage.com
R2_ENDPOINT=
R2_BUCKET=nihao-bot-assets
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Iteración 5B: provider de extracción Mistral, sólo server-side.
MISTRAL_API_KEY=

# Evolution API / WhatsApp. Sólo server-side; no usar prefijo NEXT_PUBLIC_.
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=
# Configure the Evolution instance webhook to send this as x-nihao-webhook-secret.
# Use at least 32 random characters and keep the value identical in the API and Evolution.
EVOLUTION_WEBHOOK_SECRET=

# Procesamiento durable por ráfagas v2. Aplicar migración y UAT en staging antes de activar.
WHATSAPP_BURSTS_ENABLED=false
# v3 tools: new conversations only; existing conversations keep their processor.
WHATSAPP_AGENT_TOOLS_ENABLED=false
# Sólo para una ventana UAT que reutiliza una instancia real. Si está definida,
# los demás remitentes se conservan en cuarentena durable y nunca reciben respuestas.
# Separar varios números internacionales completos con coma, punto y coma o salto de línea.
WHATSAPP_UAT_ALLOWED_PHONES=
OPENAI_API_KEY=
WHATSAPP_AGENT_MODEL=gpt-5.6-luna
# Autorización del endpoint del worker; generar un secreto por entorno.
WHATSAPP_BATCH_SECRET=

# WhatsApp operational budgets (route maxDuration remains 300 seconds).
# CLI/default workers use this runtime; HTTP routes pass their configured duration.
WHATSAPP_WORKER_RUNTIME_MS=300000
WHATSAPP_SHUTDOWN_BUFFER_MS=80000
WHATSAPP_ASSET_CONCURRENCY=2
WHATSAPP_OCR_CONCURRENCY=2
WHATSAPP_VISION_CONCURRENCY=2
WHATSAPP_TEXT_CONCURRENCY=2
WHATSAPP_TRANSCRIPTION_CONCURRENCY=2
WHATSAPP_PROVIDER_REQUEST_ATTEMPTS=2
WHATSAPP_ASSET_MAX_FAILURES=5
WHATSAPP_PROVIDER_CIRCUIT_FAILURES=3
WHATSAPP_PROVIDER_CIRCUIT_COOLDOWN_MS=30000

# Monitor operativo independiente. El aviso de procesamiento se emite una sola
# vez por ráfaga; warning/critical generan alertas deduplicadas por email.
WHATSAPP_PROCESSING_NOTICE_MS=45000
WHATSAPP_OPERATIONAL_WARNING_MS=90000
WHATSAPP_OPERATIONAL_CRITICAL_MS=180000
WHATSAPP_MONITOR_INTERVAL_MS=15000
WHATSAPP_OPERATIONAL_ALERT_EMAILS=
NIHAO_PUBLIC_API_HOST=api.nihaonegocios.com

# Staging isolation and reviewed historical corrections (never production).
# NIHAO_RUNTIME_ENV=staging
# NIHAO_STAGING_DATABASE_HOST=isolated-staging-database-host
# NIHAO_PRODUCTION_DATABASE_HOST=production-database-host
# NIHAO_STAGING_R2_BUCKET=nihao-private-staging
# NIHAO_PRODUCTION_R2_BUCKET=nihao-private-production
# In staging/preview, leave BETTER_AUTH_COOKIE_DOMAIN unset (host-only)
# or use an isolated domain outside nihaonegocios.com.
