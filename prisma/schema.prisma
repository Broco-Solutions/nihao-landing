generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum TripStatus {
  PLANNED
  ACTIVE
  COMPLETED
  ARCHIVED
}

enum TripMemberRole {
  ADMIN
  TRAVELER
}

enum UserRole {
  ADMIN
  TRAVELER
}

enum TripInvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
}

enum SupplierType {
  FACTORY
  TRADING
  UNKNOWN
}

enum CaptureStatus {
  DRAFT
  CONFIRMED
}

enum WhatsAppCardState {
  PENDING
  ANALYZING
  ANALYZED
}

enum WhatsAppCommand {
  ANALYZE_CARD
}

enum WhatsAppCommandStatus {
  PROCESSING
  COMPLETED
  FAILED
  IGNORED
}

enum CaptureSourceType {
  TEXT
  IMAGE_BUSINESS_CARD
  AUDIO_TRANSCRIPT
}

enum AttachmentType {
  BUSINESS_CARD
  PRODUCT_IMAGE
  AUDIO
  OTHER
}

model User {
  id               String            @id
  role             UserRole          @default(TRAVELER)
  name             String
  email            String            @unique
  emailVerified    Boolean           @default(false)
  image            String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  sessions         Session[]
  accounts         Account[]
  tripsCreated     Trip[]            @relation("TripCreator")
  tripMemberships  TripMember[]
  companyMemberships TripCompanyMember[]
  whatsappPhone    String?           @unique
  whatsappConversation WhatsAppConversation?
  whatsappBatches WhatsAppBatch[]
  capturesCreated  SupplierCapture[] @relation("CaptureCreator")
  suppliersCreated Supplier[]        @relation("SupplierCreator")
  contactsCreated  SupplierContact[] @relation("ContactCreator")
  tripFeedback     TripFeedback[]

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@unique([providerId, accountId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Trip {
  id          String       @id @default(uuid())
  name        String
  startDate   DateTime?
  endDate     DateTime?
  status      TripStatus   @default(PLANNED)
  createdById String
  createdBy   User         @relation("TripCreator", fields: [createdById], references: [id])
  members     TripMember[]
  companies   TripCompany[]
  whatsappBatches WhatsAppBatch[]
  captures    SupplierCapture[]
  suppliers   Supplier[]
  contacts    SupplierContact[]
  invitations TripInvitation[]
  feedback TripFeedback[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([createdById])
}

model TripMember {
  tripId    String
  userId    String
  role      TripMemberRole @default(TRAVELER)
  passportNumber String?
  trip      Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)
  agendaEntries TripAgendaEntry[]
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
  onboardingCompletedAt DateTime?
  createdAt DateTime @default(now())

  @@id([tripId, userId])
  @@index([userId])
}

model TripCompany {
  id          String              @id @default(uuid())
  tripId      String
  catalogCompanyId String
  active      Boolean             @default(true)
  trip        Trip                @relation(fields: [tripId], references: [id], onDelete: Cascade)
  catalogCompany Company          @relation(fields: [catalogCompanyId], references: [id], onDelete: Restrict)
  members     TripCompanyMember[]
  captures    SupplierCapture[]
  suppliers   Supplier[]
  invitations TripInvitation[]
  whatsappBatches WhatsAppBatch[]
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@unique([tripId, catalogCompanyId])
}

model TripAgendaEntry {
  id String @id @default(uuid())
  tripId String
  userId String
  date DateTime @db.Date
  time String
  place String
  address String
  instructions String?
  traveler TripMember @relation(fields: [tripId, userId], references: [tripId, userId], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tripId, userId, date, time])
}

model TripFeedback {
  id String @id @default(uuid())
  tripId String
  userId String
  rating Int
  comment String
  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tripId, userId])
  @@index([tripId])
}

model Company {
  id             String        @id @default(uuid())
  name           String
  normalizedName String
  dedupeKey      String?       @unique
  trips          TripCompany[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([normalizedName])
}

model TripCompanyMember {
  companyId String
  userId    String
  company   TripCompany @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime    @default(now())

  @@id([companyId, userId])
  @@index([userId])
}

model WhatsAppConversation {
  userId    String   @id
  tripId    String?
  companyId String?
  stage     String
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model WhatsAppMessageReply {
  instance  String
  messageId String
  phone     String
  status    String
  kind      String?
  text      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@id([instance, messageId])
}

model WhatsAppBatch {
  id          String   @id @default(uuid())
  instance    String
  phone       String
  userId      String
  tripId      String?
  companyId   String?
  status      String   @default("OPEN")
  dueAt       DateTime
  claimedAt   DateTime?
  attempts    Int      @default(0)
  analysis    Json?
  replySentAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User @relation(fields: [userId], references: [id], onDelete: Cascade)
  trip        Trip? @relation(fields: [tripId], references: [id], onDelete: Cascade)
  company     TripCompany? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  messages    WhatsAppBatchMessage[]

  @@index([status, dueAt])
  @@index([instance, phone, createdAt])
}

model WhatsAppBatchMessage {
  id                String   @id @default(uuid())
  batchId           String
  instance          String
  messageId         String
  type              String
  text              String?
  storageKey        String?
  mimeType          String?
  ocrText           String?
  transcription     String?
  transcriptionModel String?
  status            String   @default("PENDING")
  suggestedProvider String?
  assignedCaptureId String?
  createdAt         DateTime @default(now())
  batch             WhatsAppBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  audioSegments     WhatsAppAudioSegment[]

  @@unique([instance, messageId])
  @@index([batchId, createdAt])
}

model WhatsAppAudioSegment {
  id                String   @id @default(uuid())
  batchMessageId    String
  segmentIndex      Int
  text              String
  status            String   @default("PENDING")
  suggestedProvider String?
  assignedCaptureId String?
  batchMessage      WhatsAppBatchMessage @relation(fields: [batchMessageId], references: [id], onDelete: Cascade)
  capture           SupplierCapture? @relation(fields: [assignedCaptureId], references: [id], onDelete: SetNull)

  @@unique([batchMessageId, segmentIndex])
  @@index([assignedCaptureId])
}

model TripInvitation {
  id         String               @id @default(uuid())
  tripId     String
  companyId  String
  email      String
  name       String?
  whatsappPhone String?
  tokenHash  String               @unique
  status     TripInvitationStatus @default(PENDING)
  expiresAt  DateTime
  acceptedAt DateTime?
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt
  trip       Trip                 @relation(fields: [tripId], references: [id], onDelete: Cascade)
  company    TripCompany          @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([tripId, status])
}

model SupplierCapture {
  id                        String            @id @default(uuid())
  tripId                    String
  companyId                 String
  createdById               String
  status                    CaptureStatus     @default(DRAFT)
  whatsappCardState         WhatsAppCardState?
  sourceType                CaptureSourceType
  sourceText                String?
  sourceAttachmentId        String?
  companyName               String?
  website                   String?
  contactMethods            Json              @default("[]")
  city                      String?
  province                  String?
  contact                   String?
  category                  String?
  supplierType              SupplierType      @default(UNKNOWN)
  fobAmount                 Decimal?          @db.Decimal(12, 4)
  fobCurrency               String?
  fobUnit                   String?
  fobRawText                String?
  moqQuantity               Int?
  moqUnit                   String?
  moqNotes                  String?
  moqRawText                String?
  leadTimeRawText           String?
  leadTimeDays              Int?
  interestScore             Int?
  missingFields             Json
  reviewFields              Json
  acknowledgedUnknownFields Json
  evidence                  Json
  humanCorrectedFields      Json              @default("[]")
  analyzedAttachmentIds     Json              @default("[]")
  needsReanalysis           Boolean           @default(false)
  confirmedAt               DateTime?
  trip                      Trip              @relation(fields: [tripId], references: [id], onDelete: Cascade)
  company                   TripCompany       @relation(fields: [companyId], references: [id], onDelete: Restrict)
  createdBy                 User              @relation("CaptureCreator", fields: [createdById], references: [id])
  supplier                  Supplier?         @relation("CaptureSupplier")
  attachments               SupplierAttachment[]
  products                  SupplierProduct[]
  whatsappCommandReceipts    WhatsAppCommandReceipt[]
  whatsappAudioSegments      WhatsAppAudioSegment[]
  createdAt                 DateTime          @default(now())
  updatedAt                 DateTime          @updatedAt

  @@index([tripId, createdById])
  @@index([companyId])
}

model WhatsAppCommandReceipt {
  id                String                @id @default(uuid())
  instance          String
  messageId         String
  command           WhatsAppCommand
  status            WhatsAppCommandStatus
  tripId            String
  createdById       String
  supplierCaptureId String?
  supplierCapture   SupplierCapture?      @relation(fields: [supplierCaptureId], references: [id], onDelete: SetNull)
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  @@unique([instance, messageId])
  @@index([supplierCaptureId])
}

model Supplier {
  id            String          @id @default(uuid())
  tripId        String
  companyId     String
  createdById   String
  captureId     String          @unique
  status        CaptureStatus   @default(CONFIRMED)
  companyName   String?
  website       String?
  city          String?
  province      String?
  category      String?
  supplierType  SupplierType    @default(UNKNOWN)
  fobAmount     Decimal?        @db.Decimal(12, 4)
  fobCurrency   String?
  fobUnit       String?
  fobRawText    String?
  moqQuantity   Int?
  moqUnit       String?
  moqNotes      String?
  moqRawText    String?
  leadTimeRawText String?
  leadTimeDays  Int?
  interestScore Int?
  pendingFields Json
  trip          Trip            @relation(fields: [tripId], references: [id], onDelete: Cascade)
  company       TripCompany     @relation(fields: [companyId], references: [id], onDelete: Restrict)
  createdBy     User            @relation("SupplierCreator", fields: [createdById], references: [id])
  capture       SupplierCapture @relation("CaptureSupplier", fields: [captureId], references: [id], onDelete: Restrict)
  contacts      SupplierContact[]
  products      SupplierProduct[]
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([tripId, updatedAt])
  @@index([companyId])
  @@index([createdById])
}

model SupplierContact {
  id          String   @id @default(uuid())
  supplierId  String
  tripId      String
  createdById String
  rawText     String
  type        String?
  supplier    Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  trip        Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  createdBy   User     @relation("ContactCreator", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([supplierId])
  @@index([tripId, createdById])
}

model SupplierProduct {
  id                 String @id @default(uuid())
  captureId          String
  supplierId         String?
  name               String
  fobAmount          Decimal? @db.Decimal(12, 4)
  fobCurrency        String?
  fobUnit            String?
  fobRawText         String?
  moqQuantity        Int?
  moqUnit            String?
  moqNotes           String?
  moqRawText         String?
  leadTimeRawText    String?
  leadTimeDays       Int?
  capture            SupplierCapture @relation(fields: [captureId], references: [id], onDelete: Cascade)
  supplier           Supplier? @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  images             SupplierAttachment[]
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([captureId])
  @@index([supplierId])
}

model SupplierAttachment {
  id                String             @id @default(uuid())
  supplierCaptureId String
  productId         String?
  type              AttachmentType
  storageKey        String             @unique
  mimeType          String
  size              Int
  transcription     String?
  transcriptionModel String?
  transcribedAt     DateTime?
  supplierCapture   SupplierCapture    @relation(fields: [supplierCaptureId], references: [id], onDelete: Cascade)
  product           SupplierProduct?   @relation(fields: [productId], references: [id], onDelete: SetNull)
  createdAt         DateTime           @default(now())

  @@index([supplierCaptureId])
  @@index([productId])
}
