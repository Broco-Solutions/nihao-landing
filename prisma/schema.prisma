generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum TripStatus {
  PLANNED
  ACTIVE
  COMPLETED
  ARCHIVED
}

enum SupplierType {
  FACTORY
  TRADING
  UNKNOWN
}

enum CaptureStatus {
  DRAFT
  CONFIRMED
}

enum CaptureSourceType {
  TEXT
  IMAGE_BUSINESS_CARD
  AUDIO_TRANSCRIPT
}

enum AttachmentType {
  BUSINESS_CARD
  PRODUCT_IMAGE
  AUDIO
  OTHER
}

model User {
  id               String            @id
  name             String
  email            String            @unique
  emailVerified    Boolean           @default(false)
  image            String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  sessions         Session[]
  accounts         Account[]
  tripsCreated     Trip[]            @relation("TripCreator")
  tripMemberships  TripMember[]
  capturesCreated  SupplierCapture[] @relation("CaptureCreator")
  suppliersCreated Supplier[]        @relation("SupplierCreator")
  contactsCreated  SupplierContact[] @relation("ContactCreator")

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@unique([providerId, accountId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Trip {
  id          String       @id @default(uuid())
  name        String
  startDate   DateTime?
  endDate     DateTime?
  status      TripStatus   @default(PLANNED)
  createdById String
  createdBy   User         @relation("TripCreator", fields: [createdById], references: [id])
  members     TripMember[]
  captures    SupplierCapture[]
  suppliers   Supplier[]
  contacts    SupplierContact[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([createdById])
}

model TripMember {
  tripId    String
  userId    String
  trip      Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([tripId, userId])
  @@index([userId])
}

model SupplierCapture {
  id                        String            @id @default(uuid())
  tripId                    String
  createdById               String
  status                    CaptureStatus     @default(DRAFT)
  sourceType                CaptureSourceType
  sourceText                String?
  sourceAttachmentId        String?
  companyName               String?
  city                      String?
  province                  String?
  contact                   String?
  category                  String?
  supplierType              SupplierType      @default(UNKNOWN)
  fobAmount                 Decimal?          @db.Decimal(12, 4)
  fobCurrency               String?
  fobUnit                   String?
  fobRawText                String?
  moqQuantity               Int?
  moqUnit                   String?
  moqNotes                  String?
  moqRawText                String?
  leadTimeRawText           String?
  leadTimeDays              Int?
  interestScore             Int?
  missingFields             Json
  reviewFields              Json
  acknowledgedUnknownFields Json
  evidence                  Json
  confirmedAt               DateTime?
  trip                      Trip              @relation(fields: [tripId], references: [id], onDelete: Cascade)
  createdBy                 User              @relation("CaptureCreator", fields: [createdById], references: [id])
  supplier                  Supplier?         @relation("CaptureSupplier")
  attachments               SupplierAttachment[]
  createdAt                 DateTime          @default(now())
  updatedAt                 DateTime          @updatedAt

  @@index([tripId, createdById])
}

model Supplier {
  id            String          @id @default(uuid())
  tripId        String
  createdById   String
  captureId     String          @unique
  status        CaptureStatus   @default(CONFIRMED)
  companyName   String?
  city          String?
  province      String?
  category      String?
  supplierType  SupplierType    @default(UNKNOWN)
  fobAmount     Decimal?        @db.Decimal(12, 4)
  fobCurrency   String?
  fobUnit       String?
  fobRawText    String?
  moqQuantity   Int?
  moqUnit       String?
  moqNotes      String?
  moqRawText    String?
  leadTimeRawText String?
  leadTimeDays  Int?
  interestScore Int?
  pendingFields Json
  trip          Trip            @relation(fields: [tripId], references: [id], onDelete: Cascade)
  createdBy     User            @relation("SupplierCreator", fields: [createdById], references: [id])
  capture       SupplierCapture @relation("CaptureSupplier", fields: [captureId], references: [id], onDelete: Restrict)
  contacts      SupplierContact[]
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([tripId, updatedAt])
  @@index([createdById])
}

model SupplierContact {
  id          String   @id @default(uuid())
  supplierId  String
  tripId      String
  createdById String
  rawText     String
  supplier    Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  trip        Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  createdBy   User     @relation("ContactCreator", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([supplierId])
  @@index([tripId, createdById])
}

model SupplierAttachment {
  id                String             @id @default(uuid())
  supplierCaptureId String
  type              AttachmentType
  storageKey        String             @unique
  mimeType          String
  size              Int
  transcription     String?
  transcriptionModel String?
  transcribedAt     DateTime?
  supplierCapture   SupplierCapture    @relation(fields: [supplierCaptureId], references: [id], onDelete: Cascade)
  createdAt         DateTime           @default(now())

  @@index([supplierCaptureId])
}
